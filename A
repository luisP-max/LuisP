students = []  # List to store student dictionaries

def register_student():
    try:
        student_id = input("Enter student ID: ").strip()
        name = input("Enter student name: ").strip()
        age = int(input("Enter student age: "))
        course = input("Enter student course: ").strip()
        status = input("Enter status (active/inactive): ").strip().lower()

        student = {
            "ID": student_id,
            "Name": name,
            "Age": age,
            "Course": course,
            "Status": status
        }
        students.append(student)
        print("Student registered successfully!\n")
    except ValueError:
        print("Invalid input for age. Please enter a number.\n")

def list_students():
    if not students:
        print("No students registered yet.\n")
    else:
        for s in students:
            print(s)
        print()

def search_student():
    keyword = input("Enter student ID or name to search: ").strip()
    found = [s for s in students if s["ID"] == keyword or s["Name"].lower() == keyword.lower()]
    if found:
        for s in found:
            print(s)
    else:
        print("Student not found.\n")

def update_student():
    student_id = input("Enter student ID to update: ").strip()
    for s in students:
        if s["ID"] == student_id:
            s["Name"] = input("Enter new name: ").strip()
            try:
                s["Age"] = int(input("Enter new age: "))
            except ValueError:
                print("Invalid age. Keeping previous value.")
            s["Course"] = input("Enter new course: ").strip()
            s["Status"] = input("Enter new status (active/inactive): ").strip().lower()
            print("Student updated successfully!\n")
            return
    print("Student not found.\n")

def delete_student():
    student_id = input("Enter student ID to delete: ").strip()
    global students
    students = [s for s in students if s["ID"] != student_id]
    print("Student deleted if existed.\n")

def menu():
    option = ""
    while option != "6":  # Controlled loop instead of while True
        print("=== Student Management System ===")
        print("1. Register Student")
        print("2. List Students")
        print("3. Search Student")
        print("4. Update Student")
        print("5. Delete Student")
        print("6. Exit")
        option = input("Choose an option: ").strip()

        if option == "1":
            register_student()
        elif option == "2":
            list_students()
        elif option == "3":
            search_student()
        elif option == "4":
            update_student()
        elif option == "5":
            delete_student()
        elif option == "6":
            print("Exiting system. Goodbye!")
        else:
            print("Invalid option. Please try again.\n")

# Program starts here
menu()
